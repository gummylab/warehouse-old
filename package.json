{
  "name": "wh-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8080",
    "tunnel": "bun run tunnel.ts",
    "dev:tunnel": "concurrently \"bun run dev\" \"bun run tunnel\"",
    "build": "next build",
    "start:next": "next start --hostname 127.0.0.1 --port 8080",
    "start": "concurrently \"bun run start:next\" \"bun run tunnel\"",
    "lint": "eslint",
    "typecheck": "bunx next typegen && bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:server": "next dev --hostname 127.0.0.1 --port 3100",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "test:e2e:ui": "NODE_OPTIONS=--conditions=react-server playwright test --ui",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@line/liff": "^2.31.2",
    "@tanstack/react-table": "^9.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudflared": "^0.7.3",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.56.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
